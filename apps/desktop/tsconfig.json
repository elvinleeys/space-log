{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client", "electron-vite/node"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src", "electron.vite.config.mts", "vitest.config.mts"]
}
