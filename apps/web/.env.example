# apps/web/.env.local 로 복사해 값을 채운다. 로컬 값은 `npx supabase status -o env` 로 확인
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 비밀값. 브라우저·데스크톱 코드에 넣지 말 것 (NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SECRET_KEY=

# 가공 서버(apps/worker). 비워 두면 가공 요청을 보내지 않고 queued로 남긴다
WORKER_URL=
WORKER_SECRET=
