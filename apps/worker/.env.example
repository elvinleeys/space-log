# apps/worker/.env 로 복사해 값을 채운다. 값은 서버 환경변수로만 두고 코드에 넣지 않는다
# 실행: uvicorn main:app --reload --env-file .env

# 웹 서버(apps/web)의 WORKER_SECRET과 같은 값. 비어 있으면 모든 가공 요청을 거부한다
WORKER_SECRET=

# 기록을 읽고 쓰는 곳: supabase(기본) 또는 memory(Supabase 없이 서버만 띄워 볼 때)
WORKER_STORE=supabase

# WORKER_STORE=supabase 일 때 필요하다. 비밀키는 RLS를 건너뛰므로 서버에만 둔다
SUPABASE_URL=
SUPABASE_SECRET_KEY=
