# apps/worker/.env 로 복사해 값을 채운다. 값은 서버 환경변수로만 두고 코드에 넣지 않는다
# 실행: uvicorn main:app --reload --env-file .env

# 웹 서버(apps/web)의 WORKER_SECRET과 같은 값. 비어 있으면 모든 가공 요청을 거부한다
WORKER_SECRET=

# 기록을 읽고 쓰는 곳: supabase(기본) 또는 memory(Supabase 없이 서버만 띄워 볼 때)
WORKER_STORE=supabase

# WORKER_STORE=supabase 일 때 필요하다. 비밀키는 RLS를 건너뛰므로 서버에만 둔다
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 가공 서버가 쓰는 AI. 회사와 키는 모든 AI 일이 함께 쓰고, 모델만 일마다 따로 고른다
# 키를 비워 두면 AI를 부르지 않는다. 키를 넣으면 사용자가 올린 이미지와 기록에서 뽑은 글자·메모가 그 AI 회사로 전송된다
# 어느 AI를 쓸지: openai, claude, gemini (비우면 openai)
AI_PROVIDER=
AI_API_KEY=
# 그림 설명에 쓸 모델 (config.py의 IMAGE_DESCRIPTION_ENABLED로 켜고 끈다). 비우면 그 회사의 기본 모델
VISION_MODEL=
# 가공 후 그룹 추천에 쓸 모델 ('분류 안 된 기록'만, recommend.py). 비우면 그 회사의 기본 모델
RECOMMEND_MODEL=
# AI 분석(핵심 1줄 + 요약 3개)에 쓸 모델 ('AI 분석하기'·챗봇 요청 때만, analysis.py). 비우면 그 회사의 기본 모델
ANALYSIS_MODEL=
